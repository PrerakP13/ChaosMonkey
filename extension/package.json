{
  "name": "chaos-monkey",
  "displayName": "Chaos Monkey for VS Code",
  "description": "Scan, analyze, and simulate failures in your Python project using Chaos Engineering.",
  "version": "1.0.1",
  "publisher": "prerak",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:chaos.scanProject",
    "onCommand:chaos.openGraph"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "chaos.scanProject",
        "title": "Chaos: Scan Project"
      },
      {
        "command": "chaos.openGraph",
        "title": "Chaos: Open Graph"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chaosSidebar",
          "title": "Chaos",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "chaosSidebar": [
        {
          "id": "chaosSidebar",
          "name": "Chaos Services"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run copy-media",
    "copy-media": "xcopy \"media\" \"out\\media\" /E /I /Y",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.120.0",
    "typescript": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PrerakP13/ChaosMonkey"
  }
}
